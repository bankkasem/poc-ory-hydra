{
  "name": "poc-ory-hydra",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --workspaces --if-present dev",
    "build": "bun run --workspaces --if-present build",
    "setup": "bun --env-file=apps/backend/.env.local --env-file=apps/frontend/.env.local scripts/setup-hydra-client.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.14"
  }
}
